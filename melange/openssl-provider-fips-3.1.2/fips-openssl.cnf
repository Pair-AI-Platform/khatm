# System OpenSSL configuration installed by openssl-config-fipshardened.
#
# Loads only the OpenSSL FIPS Provider 3.1.2 (CMVP #4985) and the base provider (encoders and
# decoders, no cryptography), and makes fips=yes the default property query, so every algorithm
# fetched without an explicit provider comes from the validated module.
#
# The [fips_sect] section is defined only by fipsmodule.cnf, which `openssl fipsinstall -pedantic`
# wrote when the package was built. The security policy (section 11.1) forbids changing it by any
# other means, so this file only references it.
config_diagnostics = 1
openssl_conf = openssl_init

.pragma includedir:/etc/ssl
.include fipsmodule.cnf

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect
ssl_conf = ssl_module

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes

[ssl_module]
system_default = tls_policy

# Default TLS policy for every program that uses the system configuration. It stays compatible
# with public servers (RSA-2048 certificates, SHA-256 chains) and removes what the module's
# security policy does not allow or what no GCC standard accepts. openssl-config-fips-strict has
# the narrower NCA NCS-1:2020 set.
[tls_policy]
# Lowest version for federal systems (NIST SP 800-52 Rev. 2); Qatar QNCS Table 10, NCS-1 §4.2
MinProtocol = TLSv1.2
# TLS 1.2: forward secrecy and AEAD only, no CBC or SHA-1 MAC suites (CBK CORF §5.3.1.3(i))
CipherString = ECDHE+AESGCM:ECDHE+AESCCM:DHE+AESGCM:DHE+AESCCM:!aNULL:!CCM8:@SECLEVEL=2
# X25519 and X448 are "Non-Approved, Not Allowed" in the security policy (Table 8); finite-field
# DH only from 3072 bits (NCS-1 §2.2, NIST SP 800-57)
Groups = P-256:P-384:P-521:ffdhe3072:ffdhe4096
# No Ed25519 / Ed448 (not allowed by the security policy) and no SHA-1 signatures
SignatureAlgorithms = ECDSA+SHA256:ECDSA+SHA384:ECDSA+SHA512:rsa_pss_rsae_sha256:rsa_pss_rsae_sha384:rsa_pss_rsae_sha512:rsa_pss_pss_sha256:rsa_pss_pss_sha384:rsa_pss_pss_sha512:RSA+SHA256:RSA+SHA384:RSA+SHA512
