# System OpenSSL configuration installed by openssl-config-fips-strict.
#
# The same providers as openssl-config-fipshardened (only the FIPS Provider 3.1.2, CMVP #4985, and
# the base provider, with fips=yes), plus a TLS policy limited to NCA NCS-1:2020 at the MODERATE
# level, which also stays within Qatar QNCS v1.0. It is meant for closed networks and national
# PKIs: servers with RSA-2048 certificates anywhere in their chain, which includes most public
# websites, are refused.
#
# The [fips_sect] section is defined only by fipsmodule.cnf, which `openssl fipsinstall -pedantic`
# wrote when the package was built. The security policy (section 11.1) forbids changing it by any
# other means, so this file only references it.
config_diagnostics = 1
openssl_conf = openssl_init

.pragma includedir:/etc/ssl
.include fipsmodule.cnf

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect
ssl_conf = ssl_module

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes

[ssl_module]
system_default = tls_policy

[tls_policy]
# NCS-1 §4.2: TLS 1.2 and 1.3
MinProtocol = TLSv1.2
# NCS-1 §4.2 accepted TLS 1.2 suites with ECDHE and ECDSA. Left out, which is stricter than NCS-1:
# the CCM_8 suites (8-byte tags) and the DH/DHE suites (NCS-1 §3.6.2 names the RFC 3526 groups,
# which TLS does not negotiate). Security level 3 (128-bit) refuses RSA keys below 3072 bits and EC
# keys below 256 bits anywhere in the peer's or our own certificate chain (NCS-1 §2.2, §5.1).
CipherString = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES256-CCM:ECDHE-ECDSA-AES128-CCM:@SECLEVEL=3
# NCS-1 §4.2: the only accepted TLS 1.3 suite
Ciphersuites = TLS_AES_256_GCM_SHA384
# NCS-1 §3.6.2: ECDH with 256- to 384-bit keys at MODERATE
Groups = P-384:P-256
# NCS-1 §2.3 accepts SHA2-384 (not SHA-256 or SHA-512) and §3.8 ECDSA and RSA-PSS. These are the
# handshake signatures; certificate chains signed with other hashes are not refused by OpenSSL, so
# the CA has to issue SHA-384 certificates. TLS 1.3 then needs P-384 or RSA-PSS certificates.
SignatureAlgorithms = ECDSA+SHA384:rsa_pss_rsae_sha384:rsa_pss_pss_sha384
